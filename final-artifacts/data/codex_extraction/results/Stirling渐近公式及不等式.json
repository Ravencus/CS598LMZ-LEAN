      "domain": "real analysis",
      "key_techniques": ["Euler-Maclaurin summation", "Wallis product", "asymptotic expansion"],
      "prerequisites": ["asymptotic notation", "integration", "logarithms", "factorials"]
    },
    {
      "id": "stirling-2",
      "statement_en": "For a smooth function \\(f:[m,n]\\to\\mathbb{C}\\),\n\\[\n\\sum_{k=m}^{n}f(k)=\\int_{m}^{n}f(t)dt+\\frac{f(m)+f(n)}{2}+\\sum_{r=1}^{\\lfloor p/2\\rfloor}\\frac{B_{2r}}{(2r)!}\\left(f^{(2r-1)}(n)-f^{(2r-1)}(m)\\right)+\\frac{(-1)^{p+1}}{p!}\\int_{m}^{n}B_{p}(\\{t\\})f^{(p)}(t)dt.\n\\]",
      "statement_zh": "$$\\sum_{k=m}^{n}f(k)=\\int_{m}^{n}f(t)dt+\\frac{f(m)+f(n)}{2}+\\sum_{r=1}^{\\lfloor p/2\\rfloor}\\frac{B_{2r}}{(2r)!}\\left(f^{(2r-1)}(n)-f^{(2r-1)}(m)\\right)+\\frac{(-1)^{p+1}}{p!}\\int_{m}^{n}B_{p}(\\{t\\})f^{(p)}(t)dt$$",
      "type": "theorem",
      "difficulty": "medium",
      "domain": "real analysis",
      "key_techniques": ["Euler-Maclaurin summation", "Bernoulli polynomials"],
      "prerequisites": ["smooth functions", "higher derivatives", "Bernoulli numbers"]
    },
    {
      "id": "stirling-3",
      "statement_en": "For \\(p\\ge 2\\), the Bernoulli polynomial satisfies\n\\[\n|B_p(\\{t\\})|\\le \\frac{2p!}{(2\\pi)^p}\\zeta(p).\n\\]",
      "statement_zh": "$$|B_{p}(\\{t\\})|\\leq\\frac{2p!}{(2\\pi)^p}\\zeta(p)$$",
      "type": "lemma",
      "difficulty": "medium",
      "domain": "real analysis",
      "key_techniques": ["Bernoulli polynomial estimates", "remainder control"],
      "prerequisites": ["Bernoulli polynomials", "Riemann zeta function"]
    },
    {
      "id": "stirling-4",
      "statement_en": "Wallis product:\n\\[\n\\frac{\\pi}{2}= \\prod_{n \\geq 1} \\frac{2 n}{2 n-1}\\frac{2 n}{2 n+1}= \\lim_{n \\to +\\infty}\\frac{1}{2 n+1} \\cdot \\frac{2^{4 n}(n !)^4}{[(2 n)!]^2}.\n\\]",
      "statement_zh": "$$\\frac{\\pi}{2}= \\prod_{n \\geq 1} \\frac{2 n}{2 n-1}\\frac{2 n}{2 n+1}= \\lim_{n \\to +\\infty}\\frac{1}{2 n+1} \\cdot \\frac{2^{4 n}(n !)^4}{(2 n)!]^2}$$",
      "type": "theorem",
      "difficulty": "medium",
      "domain": "real analysis",
      "key_techniques": ["Wallis product", "infinite products", "constant identification in asymptotics"],
      "prerequisites": ["limits", "factorials", "infinite products"]
    },
